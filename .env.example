APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Key rotation: move the old APP_KEY here (comma separated) and keep it until the draws created before are purged (expiration + 3 weeks, so up to ~1 year)
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
APP_EMAIL=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_NAME=SecretSanta.fr
MAIL_FROM_ADDRESS=noreply@secretsanta.fr

MAIL_RETURN_PATH=noreply-bounce-*@secretsanta.fr

MAIL_DKIM_SELECTOR=
MAIL_DKIM_DOMAIN=secretsanta.fr
MAIL_DKIM_PRIVATE_KEY=storage/app/dkim.key

IMAP_HOST=
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_DEFAULT_ACCOUNT=default
IMAP_PROTOCOL=imap

METRICS_BACKEND=influxdb
IDB_HOST=localhost
IDB_DATABASE=secretsanta

QUEUE_CONNECTION=sync

HASHIDS_SALT_SANTA=
HASHIDS_SALT_DRAW=
HASHIDS_SALT_DEARSANTA=
HASHIDS_SALT_BOUNCE=

NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

BMC_ME=

# Live mail statuses in the organizer panel: reverb + `php artisan reverb:start` (supervisor), null to disable
BROADCAST_CONNECTION=null

REVERB_APP_ID=secretsanta
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Public address the browsers connect to (proxied to REVERB_SERVER_PORT)
REVERB_HOST=secretsanta.fr
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_PORT=8080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
