{
    "name": "korko/secretsanta",
    "description": "An organsation tool for secret santa parties.",
    "keywords": [
        "secretsanta",
        "tool"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-openssl": "*",
        "influxdata/influxdb-client-php": "^3.9",
        "korko/validator": "dev-master",
        "laravel/framework": "^13.0",
        "laravel/prompts": "^0.3.8",
        "laravel/reverb": "^1.4",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "nunomaduro/essentials": "^1.2",
        "predis/predis": "^3.0",
        "pusher/pusher-php-server": "^7.0",
        "spatie/laravel-blade-javascript": "^2.8",
        "stechstudio/laravel-metrics": "^2.6",
        "vinkla/hashids": "^14.0",
        "webklex/laravel-imap": "^6.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.5",
        "dg/bypass-finals": "^1.11",
        "driftingly/rector-laravel": "^2.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.14",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.51",
        "librenms/laravel-vue-i18n-generator": "dev-master",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-faker": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.1",
        "rector/rector": "^2.8",
        "roave/security-advisories": "dev-latest"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.4.27"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "build": [
            "@php artisan vue-i18n:generate --multi-locales",
            "npm run build"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "test": [
            "@test:unit",
            "@test:lint",
            "@test:types",
            "@test:type-coverage"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "lint": [
            "rector",
            "pint --parallel"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run"
        ],
        "test:types": "phpstan --memory-limit=2G",
        "test:type-coverage": "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=80",
        "test:unit": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/korko/laravel-vue-i18n-generator"
        }
    ]
}
